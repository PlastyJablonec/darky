# Frontend configuration

# Public URL of the Supabase API used by the frontend.
VITE_SUPABASE_URL=https://api.example.com

# Public anon key from the self-hosted Supabase instance.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Gemini API key for AI gift suggestions.
# If omitted, the app falls back to local suggestion logic.
VITE_GEMINI_API_KEY=your-gemini-key
